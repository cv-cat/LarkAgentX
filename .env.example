# LarkAgentX 配置(全部有默认值,按需修改)
# 复制为 .env 放在项目根目录即可生效

# 区域: feishu(飞书国内版) | lark(Lark 国际版 larksuite.com)
# 只决定首次登录走哪边;登录后以凭证里记录的区域为准,切换用 lark auth qr --region <feishu|lark>
LARKX_REGION=feishu

# 数据目录(凭证/消息库/agent 会话)
LARKX_HOME=~/.larkx

# 消息存储: 留空 = SQLite(自动存到 LARKX_HOME/messages.db)
# 用 MySQL 则填: mysql+pymysql://<user>:<password>@<host>:3306/<db>
LARKX_STORAGE_URL=

# agent 上下文边界: anchor(会话+话题) | chat(会话) | global(全部共享)
LARKX_CONTEXT_SCOPE=global

# agent 后端: claude | codex | none
LARKX_AGENT_BACKEND=claude

# 数字人系统提示词(留空用内置默认)
LARKX_SYSTEM_PROMPT=

# 收到消息自动标记已读(默认开;手机端未读角标会清掉)
LARKX_MARK_READ=true

# 回复方式。话题里的消息: true 回到话题 | false 发到外面的主会话
LARKX_REPLY_IN_TOPIC=true
# 主会话的消息: direct 直接发 | quote 引用原消息 | thread 开话题回复
LARKX_REPLY_MODE=direct
# 是否处理别人发来的私聊
LARKX_TRIGGER_DM_ENABLED=true
# 是否处理「和自己的会话」(给自己发消息也交给 agent)
LARKX_TRIGGER_SELF_CHAT_ENABLED=false

# 触发前缀: 只处理以此前缀开头的消息(留空 = 全部处理)
# 例: LARKX_TRIGGER_PREFIX=/run
LARKX_TRIGGER_PREFIX=

# 登录凭证不放这里,用命令管理:
#   lark auth qr                            扫码登录(推荐)
#   lark auth import --cookie "<cookie>"    手动导入

# web 控制台访问令牌(lark web 监听非本机地址时必填;本机访问可不设)
LARKX_WEB_TOKEN=

# 说明: 上面的 agent/提示词/触发规则是全局默认值,
# 在 web 控制台里按账号保存的设置优先级更高(多账号各用各的)。
